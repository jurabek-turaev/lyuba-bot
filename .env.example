# === Namuna fayl — buni .env ga nusxalab, o'z qiymatlaringizni yozing ===
# cp .env.example .env

# BotFather'dan olingan token
BOT_TOKEN=

# Bot egasining Telegram ID'si (tabel /tabel faqat shu odamga yuboriladi)
OWNER_ID=

# Savdo filiallari uchun umumiy guruh ID'si
GROUP_ID=

# Ishlab chiqarish hududi (Ishlab chiqarish / Haydovchi / I.T.R uchun)
PRODUCTION_LAT=
PRODUCTION_LON=
PRODUCTION_GROUP_ID=

# Ruxsat etilgan maksimal masofa (metr)
MAX_DISTANCE=

# Maksimal smena davomiyligi (soat) — auto-close uchun
MAX_SHIFT_HOURS=
