# === Namuna fayl — buni .env ga nusxalab, o'z qiymatlaringizni yozing ===
# cp .env.example .env

# BotFather'dan olingan token
BOT_TOKEN=

# Bot egasining Telegram ID'si (tabel /tabel faqat shu odamga yuboriladi)
OWNER_ID=

# Dasturchining Telegram ID'si (test uchun: masofa tekshiruvidan ozod)
DEVELOPER_ID=

# Ruxsat etilgan maksimal masofa (metr) — barcha filiallar uchun
MAX_DISTANCE=

# Maksimal smena davomiyligi (soat) — auto-close uchun
MAX_SHIFT_HOURS=

# Rezyume PDF'ini yasaydigan RenderCV python'i (ixtiyoriy). Docker'da va lokal
# .venv-rendercv bo'lsa BO'SH qoldiring — bot o'zi topadi.
RESUME_RENDERER_PYTHON=

# --- Faqat ESKI bazani ko'chirish uchun (ixtiyoriy) ---
# Bo'lim va filiallar endi bazada saqlanadi va botda boshqariladi (/filiallar).
# Bu qiymatlar faqat katalog birinchi marta yaratilganda eski sozlamani ko'chirish
# uchun o'qiladi. Yangi o'rnatishda BO'SH qoldiring.
GROUP_ID=
PRODUCTION_LAT=
PRODUCTION_LON=
PRODUCTION_GROUP_ID=
